# PostgreSQL connection (Railway: reference the Postgres service's DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/nitro"
# Signs admin session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=""
# 32-byte base64 key encrypting codes/account credentials at rest. Generate: openssl rand -base64 32
# Never change it after stock is uploaded, or existing stock becomes unreadable.
INVENTORY_ENCRYPTION_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Payment gateways: each one is enabled when its secret key is set; the buyer picks one at checkout.
# Leave ALL keys empty to run in dev mode (outside production only): orders and wallet top-ups are
# marked paid instantly, no real charge.
# Tap Payments (mada, KNET, Apple Pay, Gulf cards): secret key from the Tap dashboard (sk_test_... / sk_live_...).
# Charges send their own webhook URL: https://<your-domain>/api/tap/webhook (register it in Tap if asked)
# and return buyers to https://<your-domain>/api/tap/return. Both are built from NEXT_PUBLIC_SITE_URL.
TAP_SECRET_KEY=""
# Stripe (international cards). Webhook endpoint: https://<your-domain>/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Emails (sign-in codes, delivery links, ticket replies). Configure ONE of:
# 1) Resend (needs your own verified domain to email every customer)
RESEND_API_KEY=""
# 2) Gmail: SMTP_USER = your Gmail address, SMTP_PASS = a 16-letter Google "App password"
#    (Google account → Security → 2-Step Verification → App passwords). Leave EMAIL_FROM empty with Gmail.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Nitro Store <orders@yourdomain.com>"
# First super-admin, created by `npm run db:seed`
ADMIN_EMAIL="admin@nitro.store"
ADMIN_PASSWORD=""
# Shown on the contact page / footer
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
# International format without "+", e.g. 9665XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Set to "false" in production to skip the sample catalogue and demo codes
SEED_SAMPLE_PRODUCTS="true"
# Server time zone: "today" figures on the admin dashboard use it
TZ="Asia/Riyadh"
# "true" forces every admin to enable two-factor login before using the dashboard
REQUIRE_ADMIN_2FA="false"
# Optional: Telegram alerts to the owner (create a bot with @BotFather; chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Preview deployments only: "true" makes checkout and top-ups succeed instantly with no real payment
# when no gateway key is set. Never enable it on the real store.
DEMO_MODE="false"
