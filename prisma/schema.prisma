generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  CARD
  SUBSCRIPTION
  ACCOUNT
  SERVICE
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  REFUNDED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  imageUrl      String?
  type          ProductType
  active        Boolean          @default(true)
  featured      Boolean          @default(false)
  // Guarantee window for ACCOUNT products
  warrantyHours Int?
  category      Category         @relation(fields: [categoryId], references: [id])
  categoryId    String
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
}

// A sellable price point: "$10 card", "1 month", "Standard account"
model ProductVariant {
  id             String          @id @default(cuid())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  label          String
  priceCents     Int
  currency       String          @default("USD")
  sortOrder      Int             @default(0)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())

  @@index([productId])
}

// One deliverable unit: a code, or account credentials. Payload is AES-256-GCM encrypted.
model InventoryItem {
  id          String          @id @default(cuid())
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String
  payload     String          @db.Text
  status      InventoryStatus @default(AVAILABLE)
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id])
  orderItemId String?
  soldAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([variantId, status])
  @@index([orderItemId])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                  String      @id @default(cuid())
  // Secret for the customer's order page (/order/[id]?token=...)
  accessToken         String      @unique
  customer            Customer    @relation(fields: [customerId], references: [id])
  customerId          String
  status              OrderStatus @default(PENDING)
  totalCents          Int
  currency            String      @default("USD")
  stripeSessionId     String?     @unique
  stripePaymentIntent String?
  paidAt              DateTime?
  fulfilledAt         DateTime?
  items               OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  variantId      String
  // Snapshot so order history survives product edits
  productName    String
  variantLabel   String
  productType    ProductType
  quantity       Int             @default(1)
  unitPriceCents Int
  // Units delivered from stock (codes / accounts)
  inventoryItems InventoryItem[]
  // Manual delivery (SERVICE, or stock shortfall), encrypted
  deliveryNote   String?         @db.Text
  deliveredAt    DateTime?

  @@index([orderId])
}
