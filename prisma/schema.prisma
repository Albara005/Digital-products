generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  CARD
  SUBSCRIPTION
  ACCOUNT
  SERVICE
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  REFUNDED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

model Admin {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  role              AdminRole           @default(STAFF)
  // Sessions issued before this instant are rejected (password change / forced sign-out)
  passwordChangedAt DateTime?
  // TOTP 2FA: secret is AES-GCM encrypted; enabled once the first code is verified
  totpSecret        String?
  totpEnabledAt     DateTime?
  auditLogs         AuditLog[]
  recoveryCodes     AdminRecoveryCode[]
  ticketMessages    TicketMessage[]
  createdAt         DateTime            @default(now())
}

// Single-use 2FA backup codes (HMAC hashed)
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// Admin-editable store settings (referral rewards, etc.)
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId    String?
  // Kept even if the admin is later removed
  adminEmail String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  coupons     Coupon[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  imageUrl      String?
  type          ProductType
  active        Boolean          @default(true)
  featured      Boolean          @default(false)
  // Guarantee window for ACCOUNT products
  warrantyHours Int?
  category      Category         @relation(fields: [categoryId], references: [id])
  categoryId    String
  variants      ProductVariant[]
  coupons       Coupon[]
  reviews       Review[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
}

// A sellable price point: "$10 card", "1 month", "Standard account"
model ProductVariant {
  id             String          @id @default(cuid())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  label          String
  priceCents     Int
  // Supplier cost, for profit reports
  costCents      Int?
  currency       String          @default("USD")
  sortOrder      Int             @default(0)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())

  @@index([productId])
}

// One deliverable unit: a code, or account credentials. Payload is AES-256-GCM encrypted.
model InventoryItem {
  id          String          @id @default(cuid())
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String
  payload     String          @db.Text
  status      InventoryStatus @default(AVAILABLE)
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id])
  orderItemId String?
  soldAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([variantId, status])
  @@index([orderItemId])
}

model Customer {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  // Set on first successful email-code sign-in
  emailVerifiedAt    DateTime?
  walletBalanceCents Int                 @default(0)
  orders             Order[]
  walletTransactions WalletTransaction[]
  walletTopups       WalletTopup[]
  // Share link code (/?ref=CODE); generated on first account visit
  referralCode       String?             @unique
  referredBy         Customer?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredById       String?
  referrals          Customer[]          @relation("Referrals")
  rewardsEarned      ReferralReward[]    @relation("RewardReferrer")
  rewardReceived     ReferralReward?     @relation("RewardReferee")
  tickets            Ticket[]
  createdAt          DateTime            @default(now())
}

enum ReferralRewardStatus {
  PENDING
  CREDITED
  CANCELLED
}

// Wallet credit to the referrer for a referee's first paid order
model ReferralReward {
  id          String               @id @default(cuid())
  referrer    Customer             @relation("RewardReferrer", fields: [referrerId], references: [id])
  referrerId  String
  referee     Customer             @relation("RewardReferee", fields: [refereeId], references: [id])
  refereeId   String               @unique
  order       Order                @relation(fields: [orderId], references: [id])
  orderId     String               @unique
  amountCents Int
  status      ReferralRewardStatus @default(PENDING)
  creditedAt  DateTime?
  createdAt   DateTime             @default(now())

  @@index([referrerId, createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketAuthor {
  CUSTOMER
  ADMIN
}

model Ticket {
  id            String          @id @default(cuid())
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  email         String
  subject       String
  status        TicketStatus    @default(OPEN)
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?
  // Lets guests follow their ticket via a private link
  accessToken   String          @unique
  messages      TicketMessage[]
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())

  @@index([status, lastMessageAt])
  @@index([customerId])
}

model TicketMessage {
  id        String       @id @default(cuid())
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  author    TicketAuthor
  admin     Admin?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId   String?
  body      String       @db.Text
  createdAt DateTime     @default(now())

  @@index([ticketId, createdAt])
}

// One-time sign-in codes sent by email
model CustomerOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
}

// Append-only ledger; Customer.walletBalanceCents is the running total
model WalletTransaction {
  id                String                @id @default(cuid())
  customer          Customer              @relation(fields: [customerId], references: [id])
  customerId        String
  type              WalletTransactionType
  // Positive = credit, negative = debit
  amountCents       Int
  balanceAfterCents Int
  order             Order?                @relation(fields: [orderId], references: [id])
  orderId           String?
  topup             WalletTopup?          @relation(fields: [topupId], references: [id])
  topupId           String?
  note              String?
  createdAt         DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
}

enum TopupStatus {
  PENDING
  PAID
  FAILED
}

model WalletTopup {
  id           String              @id @default(cuid())
  customer     Customer            @relation(fields: [customerId], references: [id])
  customerId   String
  amountCents  Int
  currency     String              @default("USD")
  status       TopupStatus         @default(PENDING)
  provider     PaymentProvider
  // Stripe Checkout session id / Tap charge id
  providerRef  String?             @unique
  paidAt       DateTime?
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())

  @@index([customerId, createdAt])
}

enum PaymentProvider {
  STRIPE
  TAP
  WALLET
  DEV
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id               String             @id @default(cuid())
  // Stored uppercase
  code             String             @unique
  type             CouponType
  // PERCENT: 1-100; FIXED: cents
  value            Int
  minSubtotalCents Int?
  // Cap for PERCENT coupons, in cents
  maxDiscountCents Int?
  maxUses          Int?
  // Counts active (PENDING/PAID/FULFILLED) orders; released when an order fails
  usedCount        Int                @default(0)
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean            @default(true)
  // Optional scope: only lines in this category / product count toward the discount
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId        String?
  redemptions      CouponRedemption[]
  orders           Order[]
  createdAt        DateTime           @default(now())
}

model CouponRedemption {
  id            String   @id @default(cuid())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId      String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  customerEmail String
  discountCents Int
  createdAt     DateTime @default(now())

  @@index([couponId, customerEmail])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// One review per delivered order line (verified purchase)
model Review {
  id          String       @id @default(cuid())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String       @unique
  // Public display name, e.g. "أحمد" or masked email
  authorName  String
  rating      Int
  comment     String?      @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@index([productId, status, createdAt])
}

model Order {
  id                  String              @id @default(cuid())
  // Secret for the customer's order page (/order/[id]?token=...)
  accessToken         String              @unique
  customer            Customer            @relation(fields: [customerId], references: [id])
  customerId          String
  status              OrderStatus         @default(PENDING)
  // subtotal - discount = totalCents (order value); totalCents - walletAppliedCents is charged by the gateway
  subtotalCents       Int                 @default(0)
  discountCents       Int                 @default(0)
  walletAppliedCents  Int                 @default(0)
  totalCents          Int
  currency            String              @default("USD")
  coupon              Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId            String?
  couponRedemption    CouponRedemption?
  paymentProvider     PaymentProvider?
  stripeSessionId     String?             @unique
  stripePaymentIntent String?
  // Tap charge id
  tapChargeId         String?             @unique
  paidAt              DateTime?
  fulfilledAt         DateTime?
  refundedAt          DateTime?
  items               OrderItem[]
  walletTransactions  WalletTransaction[]
  referralReward      ReferralReward?
  tickets             Ticket[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  variantId      String
  // Snapshot so order history survives product edits
  productName    String
  variantLabel   String
  productType    ProductType
  quantity       Int             @default(1)
  unitPriceCents Int
  // Units delivered from stock (codes / accounts)
  inventoryItems InventoryItem[]
  // Manual delivery (SERVICE, or stock shortfall), encrypted
  deliveryNote   String?         @db.Text
  deliveredAt    DateTime?
  review         Review?

  @@index([orderId])
}
